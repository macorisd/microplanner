# Paste the real URI from Atlas here, only in your ignored server.env file.
# Deliberately empty: credential-shaped sample URIs trigger secret scanning.
MONGODB_URI=
MONGODB_DB=microplanner
# Use 0.0.0.0 only when testing an Android emulator or phone on your network.
HOST=127.0.0.1
PORT=3000
# Optional if required by your Google Desktop OAuth client at token exchange:
# GOOGLE_WINDOWS_CLIENT_SECRET=
# Optional process-local DNS override if querySrv/queryTxt fails with ECONNREFUSED:
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

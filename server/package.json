{
  "name": "microplanner-api",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=../server.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../server.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "check:atlas": "node --env-file=../server.env --import tsx src/check-atlas.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "google-auth-library": "^10.3.0",
    "mongodb": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^10.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
